{
  "name": "keylease",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "copy-lint": "node tools/repo-lint/src/cli.ts copy",
    "env-lint": "node tools/repo-lint/src/cli.ts env",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm copy-lint && pnpm env-lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
