# KeyLease environment. Names only: never put a value in this file.
# Copy to .env (git-ignored) and fill in locally. Testnet only.

# NEAR testnet
NEAR_NETWORK=
NEAR_RPC_URL=
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
KEYLEASE_CONTRACT_ID=

# OutLayer (testnet)
OUTLAYER_CONTRACT_ID=
OUTLAYER_API_BASE=
OUTLAYER_PAYMENT_KEY=

# Demo provider key (low value, provider-side hard spend limit)
NEAR_AI_CLOUD_API_KEY=

# Mock API used by the judge demo
MOCK_API_BASE_URL=

# Sponsored demo caller (function-call key, tiny allowance, mock key only)
DEMO_SPONSOR_ACCOUNT_ID=
DEMO_SPONSOR_PRIVATE_KEY=

# Web app (public build-time values)
NEXT_PUBLIC_NEAR_NETWORK=
NEXT_PUBLIC_KEYLEASE_CONTRACT_ID=
NEXT_PUBLIC_REOWN_PROJECT_ID=
